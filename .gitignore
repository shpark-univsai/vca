# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is the only documentation of what can be configured — tile
# source, support contact, API base URL — and it holds no secrets. Without this
# exception it stayed untracked, so a fresh clone had no record of any setting.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 세션 조정용 — 병렬 작업 배정 기록.
#
# 추적합니다(2026-10-13, 오너: 작업파일은 안올려두되는데 백업용에만 올려줘). 전달물이 아닌
# 것은 맞지만, 전달에서 빼는 일은 .gitignore가 아니라 반입 커밋이 합니다 — import/frontend-ui-*
# 브랜치를 만들 때 .claude · skills-lock.json과 함께 트리에서 뺍니다. 무시해 두면 백업 저장소
# (vca-frontend-history)에도 안 올라가서, 세션이 날아가면 배정 기록이 같이 사라집니다.
