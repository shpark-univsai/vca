# Backend API base URL. Copy this file to .env.local and fill in the real value
# once the backend developer's endpoint is available.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Base map --------------------------------------------------------------
# On-premise networks usually cannot reach a public tile server, so point these
# at the customer's own GIS server or at tiles shipped inside the install.
# Leaving them unset falls back to the public OpenStreetMap server, which is for
# demos and development only — OSM's usage policy does not allow a deployed
# product to rely on it.
#
#   NEXT_PUBLIC_MAP_TILE_URL=https://gis.internal/wmts/{z}/{x}/{y}.png
#   NEXT_PUBLIC_MAP_TILE_URL=/tiles/{z}/{x}/{y}.png
# For demos and development, CARTO's Positron ("light_all") is the basemap this
# product was designed against — quiet grey, no street clutter competing with the
# camera dots. It needs a free key (one minute, no account: carto.com/basemaps/apikey).
# Paste the lines below into .env.local with your key. CARTO's tiles are already
# grey, so the desaturation filter drops to a light touch-up — leaving it at the
# default would flatten an already-flat map.
#
#   NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key=YOUR_KEY
#   NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
#   NEXT_PUBLIC_MAP_TILE_FILTER=grayscale(0.1) brightness(0.98)
#
# "light_all" is Positron, the quiet grey one this product was designed against.
# CARTO also serves "dark_all" and "voyager" (full colour) at the same path.
# No {s} subdomain any more, so NEXT_PUBLIC_MAP_TILE_SUBDOMAINS stays empty.
#
# NOT for a customer installation: a closed network cannot reach CARTO at all, and
# shipping our key in a delivered build would make it commercial use under their
# fair-use terms. Deployments use the customer's GIS server or bundled tiles above.
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Only for a {s} template; comma separated, e.g. a,b,c
# NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=
# NEXT_PUBLIC_MAP_MAX_ZOOM=19

# --- Auth / account recovery ----------------------------------------------
# Who to reach when nobody can get in. Printed at the foot of the login screen,
# and it becomes the whole recovery path where there is no mail server. Leave it
# unset rather than guessing — a wrong extension is worse than a generic line,
# because someone will call it.
# NEXT_PUBLIC_SUPPORT_CONTACT=Security Operations, ext. 1234
